## @file
# Automotive CAN Injection Backdoor Emulation Module
#
# Emulates CAN bus injection backdoors delivered through compromised ECU
# firmware (Ring 0). Models ECU node enumeration, a virtual CAN-over-UEFI
# protocol, and frame injection with arbitration-ID spoofing.
#
# Copyright (c) 2026, Barzakh Research Project
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AutomotiveCanInject
  FILE_GUID                      = B1C2D3E4-5678-9ABC-DEF0-111111111106
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = AutomotiveCanInjectEntry

[Sources]
  AutomotiveCanInject.c
  AutomotiveCanInject.h

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  DebugLib
  PrintLib

[Depex]
  TRUE
